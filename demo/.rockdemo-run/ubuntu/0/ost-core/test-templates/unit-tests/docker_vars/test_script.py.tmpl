import pytest
import os

class TestDockerVars:
    def test_simple_print(self):
        print("Hello from python container")
        assert True

    # test_location removed - we change working directory to avoid pytest discovery issues
    # The working directory is now $TEMPLATE_DIR/$OPERATION instead of the ostrich.yaml location


    def test_unit_file(self):
        # Check file unit.txt exists
        unit_file = '[[ "unit.txt" | here | toUnixPath ]]'
        print(f"Checking unit file: {unit_file}")
        assert os.path.isfile(unit_file)

    def test_template_location(self):
        # check template location
        tpl_dir = '[[ "." | fromTemplate | toUnixPath ]]'
        display_docker_dir = '[[ "docker_display" | fromTemplate | toUnixPath ]]'
        print(f"Checking template dir: {tpl_dir}")
        assert os.path.isdir(tpl_dir)
        assert os.path.isdir(display_docker_dir)

    def test_templates_global_location(self):
        # Templates location check (fromTemplates)
        templates_root = '[[ "." | fromTemplates | toUnixPath ]]'
        global_dir = '[[ "global" | fromTemplates | toUnixPath ]]'
        print(f"Checking templates root: {templates_root}")
        assert os.path.isdir(templates_root)
        assert os.path.isdir(global_dir)

    def test_job_location(self):
        # Job source location check (fromJob)
        job_dir = '[[ "." | fromJob | toUnixPath ]]'
        # Use a file that actually exists in this job's source directory
        job_template = '[[ "test_script.py.tmpl" | fromJob | toUnixPath ]]'
        print(f"Checking job dir: {job_dir}")
        assert os.path.isdir(job_dir)
        assert os.path.isfile(job_template)

    def test_template_instance_location(self):
        # Template instance location check (fromTemplateInstance)
        tpl_inst_dir = '[[ "." | fromTemplateInstance | toUnixPath ]]'
        # Use a file that exists in the instance directory
        # docker_vars.yaml.tmpl becomes docker_vars/docker_vars.yaml
        tpl_inst_file = '[[ "docker_vars/docker_vars.yaml" | fromTemplateInstance | toUnixPath ]]'
        print(f"Checking template instance: {tpl_inst_dir}")
        assert os.path.isdir(tpl_inst_dir)
        assert os.path.isfile(tpl_inst_file)

    def test_loglevel_constants(self):
        # Verify injected loglevel constants
        print(f"Checking LOGLEVEL={os.getenv('LOGLEVEL')}")
        assert os.getenv('OST_DEBUG') == '10'
        assert os.getenv('OST_INFO') == '20'
        assert os.getenv('OST_WARNING') == '30'
        assert os.getenv('OST_ERROR') == '40'
        assert os.getenv('OST_CRITICAL') == '50'
        
        # Verify we can use them to check current level
        current_level = int(os.getenv('LOGLEVEL'))
        debug_level = int(os.getenv('OST_DEBUG'))
        if os.getenv('OST_DEBUG_MODE') == 'true': # if user wants to check if debug is on
             pass
        assert current_level >= debug_level

