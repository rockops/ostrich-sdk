runner:
  kind: shell
commands:
- echo ${TEST_VAR}
- pwd
- ls -la
- echo 'Plugin [[ plugin.name ]]. Message is "[[ template.params.message ]]"'
- echo LOGLEVEL is set to ${LOGLEVEL}
- echo DRYRUN is set to ${DRYRUN}
- cat ${TEMPLATE_DIR}/${OPERATION}/data.txt
- echo "Number of operation parameters=${ARGC}"
- echo "Operation parameters (comma separated)=${ARGV}"
- echo "Operation parameters (JSON)=${ARGV_JSON}"
- |
  for i in $(seq 0 $((${ARGC}-1))); do
    echo "Parameter $i is: $(echo ${ARGV_JSON} | jq -r ".[$i]")"
  done
env:
  TEST_VAR: "Hello from displayshell template"
