#! /usr/bin/env python 
"""
Ostrich CLI Entry Point
Main orchestrator for template rendering, registry management, and task execution.
"""

import os
import sys
import logging
import tempfile
import yaml
from subprocess import CalledProcessError

import src.template as template_mod
import src.util as util
import src.conf as config_mod
import src.operations as ops_mod
import src.registry as registry_mod
from src.ostrichException import OstrichException 

APP_VERSION = "0.0.0-dev"

def display_help(exit_code=0):
    print("""Ostrich SDK Command Line Interface
Usage: ost [OPTIONS] <command> [arguments...]

Global Commands:
  - help                  : Show this assistance menu
  - template              : Manage and explore project templates
  - registry              : Interface with OCI registries
  - config                : Read or write global SDK settings
  - run <task> [args]     : Execute a specific workflow task defined by the template

Global Options:
  -d, --debug             : Enable verbose logging for troubleshooting
  -f, --file <path>       : Specify plugin manifest (default: ostrich.yaml)
  -c, --kubeconfig <path> : Path to Kubernetes configuration
  -r, --registry <url>    : Override the default Docker/OCI registry
  -o, --output <dir>      : Specify a persistent directory for rendered assets
  -dr, --dry-run          : Simulate execution and preserve output in 'dry-run/'
  --rm                    : Force purge of the output directory before rendering
  --nodeps                : Bypass dependent tasks in the workflow
  -s, --skip <task>       : Prevent a specific task from being executed
  --keep, -k              : Do not delete temporary work directories
  --nologo                : Suppress the Ostrich splash screen
  --version               : Display application version

Quick Start Examples:
  - List available templates: ost template ls
  - Initialize project:       ost template config <name> > ostrich.yaml
  - Deploy native workflow:   ost run deploy --env production
""")
    if exit_code is not None:
        sys.exit(exit_code)

# Initialize session parameters
ctx = util.OstrichRuntimeContext()
active_loglevel = logging.INFO
show_splash = "--nologo" not in sys.argv

# --- Argument Parsing Logic ---
remaining_args = sys.argv[1:]
parsing_global_flags = True

while remaining_args:
    flag = remaining_args[0]
    
    if flag in ['-f', '--file'] and parsing_global_flags:
        ctx.pluginFile = remaining_args[1]
        remaining_args = remaining_args[2:]
    elif flag in ['-c', '--kubeconfig'] and parsing_global_flags:
        ctx.kubeConfig = remaining_args[1]
        remaining_args = remaining_args[2:]
    elif flag in ['-d', '--debug'] and parsing_global_flags:
        active_loglevel = logging.DEBUG
        remaining_args = remaining_args[1:]
    elif flag in ['-r', '--registry']:
        ctx.registry = remaining_args[1]
        remaining_args = remaining_args[2:]
    elif flag in ['-o', '--output'] and parsing_global_flags:
        ctx.tmpdir = remaining_args[1]
        ctx.userOutput = True
        remaining_args = remaining_args[2:]
    elif flag in ['-dr', '--dry-run']:
        ctx.dryRun = True
        if not ctx.tmpdir: ctx.tmpdir = "dry-run"
        remaining_args = remaining_args[1:]
    elif flag == '--rm':
        ctx.rmTmpDir = True
        remaining_args = remaining_args[1:]
    elif flag in ['-nd', '--nodeps']:
        ctx.noDeps = True
        remaining_args = remaining_args[1:]
    elif flag in ['-s', '--skip']:
        ctx.skip.append(remaining_args[1])
        remaining_args = remaining_args[2:]
    elif flag == '--nologo':
        show_splash = False
        remaining_args = remaining_args[1:]
    elif flag in ['--keep', '-k']:
        ctx.deletePluginTmpDir = False
        remaining_args = remaining_args[1:]
    elif flag in ['-h', '--help', 'help'] and parsing_global_flags:
        ctx.usage = True
        remaining_args = remaining_args[1:]
    elif flag == '--version':
        print(f"Ostrich SDK {APP_VERSION}")
        sys.exit(0)
    elif flag == 'run':
        parsing_global_flags = False # Shift to task-specific arguments
        remaining_args = remaining_args[1:]
    else:
        # Check for unmapped flags or positional command start
        if flag.startswith("-") and parsing_global_flags:
            display_help(False)
            print(f"\n[Error] Invalid flag detected: {flag}")
            print("Tip: Use 'run' keyword to pass arguments to tasks.")
            sys.exit(1)
            
        if flag in ["template", "config", "registry", "help"]:
            parsing_global_flags = False
        elif not parsing_global_flags:
            pass # Already in positional part
        else:
            display_help(False)
            print("\n[Error] Missing 'run' command prefix for task arguments.")
            sys.exit(1)
            
        ctx.operationParams.append(flag)
        remaining_args = remaining_args[1:]

# --- Logging Setup ---
root_logger = logging.getLogger()
root_logger.setLevel(active_loglevel)

# Robust handler for cross-platform stability (specifically Windows handles)
log_handler = util.RobustLoggingHandler(sys.stdout)
log_handler.setFormatter(logging.Formatter('%(levelname)s - %(message)s'))
root_logger.addHandler(log_handler)

if ctx.usage:
    display_help(0)

if not ctx.operationParams:
    display_help(1)

# Shift operation name and preserve leftover params
ctx.operation = ctx.operationParams.pop(0)

# Built-in commands handle their own standard arg parsing
if ctx.operation in ["template", "config", "registry", "help"]:
    ctx.parse_cli_arguments()

# Condition splash screen visibility
if ctx.operation == "template" and ctx.operationParams and ctx.operationParams[0] in ["config", "values"]:
    show_splash = False

if show_splash and not ctx.nologo:
    print(r'''                              _              
     ____   ___  _____  ___  |_| ___  __   _  
    / __ \ / __||_   _||   ) | |/ __||  |_| | 
    |(oO)| \__ \  | |  |   \ | |\__ \)   _  | 
    \_\/_/ |___/  |_|  |_|\_\|_||___/|__| |_|_  _
      ||                            ___   __| || | __
      ||                           / __| / _` || |/ /
                                   \__ \| (_| ||   < 
                                   |___/ \__,_||_|\_\
''', flush=True)

logging.debug("Ostrich Session Started. Core Task: %s", ctx.operation)

if ctx.operation == "help":
    display_help(0)

try:
    config_mod.initialize_global_settings()
    util.define_working_location(os.path.dirname(os.path.abspath(ctx.pluginFile)))
    
    # Resolve registry priority: CLI Override > Global Config
    if not ctx.registry:
        ctx.registry = config_mod.resolve_setting_value("config.docker.registry", ctx)
    
    ctx.loglevel = active_loglevel
    
    if ctx.registry:
        logging.debug("OCI Registry context: %s", ctx.registry)
    else:
        logging.warning("Registry not configured; pipeline pushes may fail.")

    # Command Dispatch Routing
    if ctx.operation == "template":
        template_mod.manage_templates(ctx)
    elif ctx.operation == "registry":
        registry_mod.manage_registries(ctx)
    elif ctx.operation == "config":
        ops_mod.manage_configuration(ctx)
    else:
        # Workflow Task Execution
        ctx.initialize_plugin_context()
        logging.debug("Effective Context:\n%s", yaml.dump(ctx.parsedPluginConfig))

        workspace_base = os.getcwd() if "OST_WORKSPACE" in os.environ else None

        with tempfile.TemporaryDirectory(dir=workspace_base) as auto_tmp:
            if not ctx.tmpdir:
                logging.debug("Initializing workspace in: %s", auto_tmp)
                ctx.tmpdir = auto_tmp
            else:
                template_mod.prepare_output_directory(ctx)
            
            if ctx.deletePluginTmpDir:
                with tempfile.TemporaryDirectory() as p_tmp:
                    ctx.pluginTmpDir = p_tmp
                    ops_mod.orchestrate_execution(ctx)
            else:
                ctx.pluginTmpDir = tempfile.mkdtemp(prefix="ostrich-task-")
                ops_mod.orchestrate_execution(ctx)

except OstrichException as exc:
    logging.fatal("%s", exc)
    if active_loglevel <= logging.DEBUG: logging.exception(exc)
    sys.exit(1)
except (CalledProcessError, KeyboardInterrupt) as err:
    logging.fatal("Process terminated: %s", err)
    sys.exit(1)
except Exception as generic_err:
    logging.fatal("Runtime failure [%s]: %s", type(generic_err).__name__, generic_err)
    if active_loglevel <= logging.DEBUG: logging.exception(generic_err)
    raise

if ctx.dryRun:
    print(f"\n>>> Simulation Complete <<<\nNo changes applied to environment.\nArtifacts preserved in: {ctx.tmpdir}\n")
