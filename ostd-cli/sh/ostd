#!/usr/bin/env bash

#
# Wrapper script to execute ost from a Docker image
# Use:
#   - ostd => same arguments as ost
#   - ostd sh => open a shell in the container, giving you access to the tools (DEBUG purposes)
#

TOP=$(cd "$(dirname $0)" && pwd)

IMAGE="ghcr.io/rockops/ostrich-sdk"
TAG="latest"

function usage() {
    echo "Usage: ostd [options] [command]"
    echo ""
    echo "Options:"
    echo "  --image <image>  The Docker image to use (default: $IMAGE)"
    echo "  --tag <tag>      The Docker tag to use (default: $TAG)"
    echo "  -h, --help       Show this help"
    echo ""
    echo "Commands:"
    echo "  sh               Open a shell in the container"
    echo "  <ost command>    Any valid ost command"
}

# Parse arguments
PARAMS=""
ENV_VARS=()
while (( "$#" )); do
  case "$1" in
    --image)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        IMAGE=$2
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        usage
        exit 1
      fi
      ;;
    --tag)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        TAG=$2
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        usage
        exit 1
      fi
      ;;
    -e)
      if [ -n "$2" ]; then
        ENV_VARS+=("-e" "$2")
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        usage
        exit 1
      fi
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done

# Extract parameters back
set -- $PARAMS

# Handle image and tag override
if [[ "$IMAGE" == *:* ]]; then
    if [ "$TAG" != "latest" ]; then
        # Override existing tag
        IMAGE="${IMAGE%%:*}:$TAG"
    fi
else
    IMAGE="$IMAGE:$TAG"
fi

ENTRYPOINT=/sdk/ost
WORKDIR="$PWD"
DATA="-v $PWD:$PWD"

if [ "$1" == "sh" ]; then
    ENTRYPOINT=bash
    shift
    WORKDIR=/sdk
    unset DATA
fi

mkdir -p $HOME/.ostrich/docker/templates
mkdir -p $HOME/.ostrich/docker/test-templates
mkdir -p $HOME/.ostrich/docker/config
mkdir -p $HOME/.ostrich/docker/helm
mkdir -p $HOME/.ostrich/docker/sdk-config

rm -rf $HOME/.ostrich/docker/test-templates
docker run --rm --entrypoint=tar $IMAGE -C /sdk -cf - test-templates | tar -C $HOME/.ostrich/docker -xf -
docker run --rm --entrypoint=tar $IMAGE -C /sdk -cf - templates | tar -C $HOME/.ostrich/docker -xf -

# Check if we are running in a TTY
INTERACTIVE=""
if [ -t 0 ]; then
    INTERACTIVE="-i"
    if [ -t 1 ]; then
        INTERACTIVE="-it"
    fi
fi

docker run --rm $INTERACTIVE -v /var/run/docker.sock:/var/run/docker.sock \
  $DATA \
  "${ENV_VARS[@]}" \
  -w $WORKDIR \
  -v $HOME/.kube/config:/kubeconfig \
  -e KUBECONFIG=/kubeconfig \
  -e HOME=/sdk \
  -e OST_WORKSPACE="$PWD" \
  -e OST_SDK_HOST_PATH="$TOP" \
  -e OST_HOME_HOST_PATH="$HOME" \
  -v $HOME/.ostrich/docker/templates:/sdk/.ostrich/templates \
  -v $HOME/.ostrich/docker/test-templates:/sdk/test-templates \
  -v $HOME/.ostrich/docker/config:/sdk/.ostrich/config \
  -v $HOME/.ostrich/docker/helm:/sdk/.ostrich/helm \
  -v $HOME/.ostrich/docker/sdk-config:/sdk/.ostrich/sdk-config \
  -u $(id -u):$(id -g) \
  --network host \
  --group-add $(getent group docker | cut -d: -f3) \
  --entrypoint=$ENTRYPOINT \
  $IMAGE $*
